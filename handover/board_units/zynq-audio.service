# /etc/systemd/system/zynq-audio.service
[Unit]
Description=系统管家小白 板载音频服务 (ES8388 + PL, 独占)
Documentation=file:/home/zynq/ui/audio_svc.py
After=multi-user.target
Before=zynq-agent.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/zynq/ui
ExecStart=/usr/bin/python3 -u /home/zynq/ui/audio_svc.py
Restart=always
RestartSec=3
# 音频要拿大块物理连续内存 + /dev/mem，所以用 root
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zynq-audio

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/zynq-audio.service.d/alsa.conf
[Unit]
Description=系统管家小白 ES8388 ALSA 音频服务
Documentation=

[Service]
ExecStart=
ExecStart=/usr/bin/python3 -u /home/zynq/ui/audio_alsa_svc.py
User=root

# /etc/systemd/system/zynq-audio.service.d/cap-fix.conf
# ★ 2026-10-02 加：修复采集通路
#
# 根因（实测）：
#   内核 es8388 驱动把寄存器 0x0A 设成了 0x50（LIN2/RIN2 = LINE_IN 插孔），
#   但板子上的麦克风接在 LIN1/RIN1，对应的值是 0x00。
#   结果：采集一直是近乎静音（-93 dBFS，峰值几百）。
#
# 实测对照：
#   0x0A = 0x00 -> -66 ~ -75 dBFS   正常
#   0x0A = 0x50 -> -93 dBFS 峰值 889  几乎没信号
#
# 用 i2cset -f（force）绕开内核驱动的占用，不用卸载驱动。
# 前面加 "-" 表示这一步失败也不阻止服务启动。
[Service]
ExecStartPre=-+/usr/bin/python3 /home/zynq/audio_cap_init.py

# /etc/systemd/system/zynq-audio.service.d/volume-max.conf
# 开机把 ES8388 的增益全部拉到最大
# 2026-09-29 实测各项上限：
#   Playback(DAC数字) = 192 -> 0.00 dB   (量程 0-192)
#   Output 1/2        = 33  -> +4.50 dB  (量程 0-33)
#   0x1D Vpp_scale    = 1   -> 4.0V      (默认 0 = 3.5V，+1.16 dB)
#
# ★ 三个坑，都踩过了：
#   1) systemd 的 PATH 没有 /usr/sbin -> i2cget/i2cset 要写绝对路径
#   2) 写这个文件必须用不展开的 heredoc(<<'EOF')，否则 $(...) 写文件时就被求值
#   3) 本服务 User=zynq，而 /dev/i2c-1 需要 root -> 那条 ExecStartPre 要加 "+"
#      前缀才会以 root 身份执行（amixer 不需要，zynq 在 audio 组里）
[Service]
ExecStartPre=/bin/sh -c '/usr/bin/amixer -q -c 0 sset "Playback" 192 2>/dev/null; /usr/bin/amixer -q -c 0 sset "Output 1" 33 2>/dev/null; /usr/bin/amixer -q -c 0 sset "Output 2" 33 2>/dev/null; true'
ExecStartPre=+/bin/sh -c 'v=$(/usr/sbin/i2cget -f -y 1 0x10 0x1d 2>/dev/null); if [ -n "$v" ]; then /usr/sbin/i2cset -f -y 1 0x10 0x1d $(( (v & 0xfc) | 1 )) 2>/dev/null; fi; true'
